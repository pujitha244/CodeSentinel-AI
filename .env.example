# CodeSentinel AI Configuration

# Server
PORT=8000
HOST=0.0.0.0
# Local development default: leave API auth off. Enable before exposing the API.
API_AUTH_ENABLED=false
# When API_AUTH_ENABLED=true, use a random value of at least 32 characters.
API_ACCESS_TOKEN=
# Keep true outside local HTTP development.
AUTH_COOKIE_SECURE=true

# AI Provider ("auto", "rule_only", "ollama", or "openai")
AI_PROVIDER=auto

# Ollama Settings (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI Settings (Optional - Application runs 100% rule-only without API keys!)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Max Upload Size
MAX_UPLOAD_SIZE_MB=50
