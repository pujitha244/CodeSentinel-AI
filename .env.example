# CodeSentinel AI Configuration

# Server
PORT=8000
HOST=0.0.0.0

# AI Provider ("auto", "rule_only", "ollama", or "openai")
AI_PROVIDER=auto

# Ollama Settings (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI Settings (Optional - Application runs 100% rule-only without API keys!)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Max Upload Size
MAX_UPLOAD_SIZE_MB=50
